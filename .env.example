# Скопируйте этот файл в .env и заполните значения.

# --- Сервер: распознавание через Gemini ---
GEMINI_API_KEY=
# Имя модели можно сменить без правки кода
GEMINI_MODEL=gemini-3.5-flash-lite
# Запасные модели через запятую: используются, если основная не отвечает или исчерпала лимит
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest
PORT=3000

# --- Клиент: Supabase (Project Settings → API) ---
# Пока эти поля пусты, приложение работает в демо-режиме: без входа, данные в браузере.
VITE_SUPABASE_URL=
# Публикуемый ключ (sb_publishable_...). Секретный ключ сюда не вставлять.
VITE_SUPABASE_KEY=
# true — показать кнопку «Войти через Google» (после настройки провайдера в Supabase)
VITE_AUTH_GOOGLE=false
